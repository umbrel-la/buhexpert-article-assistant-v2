AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AUTH_MODE=demo
BUHEXPERT_SESSION_COOKIE=buhexpert_session
NEXT_PUBLIC_YM_COUNTER_ID=

# The visual prototype uses only public fixtures and test accounts.
# The article page selects real adapters when ASSISTANT_MODE=real; /demo stays demo.
ASSISTANT_MODE=demo
ASSISTANT_TOKEN_SECRET=
ASSISTANT_ENABLED=false
# ISO 8601 timestamp with timezone; the real pilot lasts 24 hours.
ASSISTANT_PILOT_START=

# Optional identity bridge, to be implemented by Buhexpert (POST { sessionId }).
BUHEXPERT_SESSION_VERIFY_URL=
BUHEXPERT_SESSION_VERIFY_KEY=
# Optional absolute path on a persistent server volume, never on Vercel.
# Replace lib/article-assistant/history.ts with the site's DB adapter for Vercel.
ASSISTANT_HISTORY_DIR=
